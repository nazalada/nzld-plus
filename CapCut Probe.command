#!/bin/zsh
# Один клик: поднимает бэкенд NZLD+ и запускает CapCut с инжектнутым ve_hook.dylib.
# Панель встроена в сам CapCut (вкладка NZLD+), отдельный браузер не нужен.
# ВАЖНО: перед запуском полностью выйти из CapCut (Cmd+Q) — DYLD цепляется только при старте.
cd "$(dirname "$0")" || exit 1
UD="$HOME/Movies/CapCut/User Data"
LOG="$UD/plugin_probe.log"

die() { print -r -- ""; print -r -- "✗  $1"; [ -n "$2" ] && print -r -- "   $2"; print -r -- ""
        print -r -- "Окно можно закрыть."; exit 1 }

# ── проверки ДО запуска CapCut ──────────────────────────────────────────────────
# Всё, что ниже, раньше проваливалось молча: CapCut запускался, панель появлялась,
# список слоёв был пуст — и это выглядело поломкой плагина, а не отсутствием бэкенда.

[ -d "$UD" ] || die "нет каталога $UD" "CapCut ни разу не запускался. Запусти его один раз."
[ -x .venv/bin/python ] || die "нет Python-окружения (.venv)" "Выполни ./install.sh — он его создаст."
[ -f "$UD/ve_hook.dylib" ] || die "плагин не установлен в CapCut" "Выполни ./install.sh"

CAPCUT="/Applications/CapCut.app/Contents/MacOS/CapCut"
[ -x "$CAPCUT" ] || die "CapCut не найден в /Applications" "Поставь CapCut."

# Версия CapCut. Плагин цепляется за внутренности сборки: функции резолвятся по именам
# символов и обновления обычно переживают, а вот смещения полей структур — нет, и на
# чужой сборке дадут мусор молча. Лучше честный отказ здесь, чем сутки отладки потом.
# Проверку можно отключить: NZLD_ANY_VERSION=1 ./CapCut\ Probe.command
KNOWN=("9.1.0" "9.2.0")
VER=$(defaults read /Applications/CapCut.app/Contents/Info.plist CFBundleShortVersionString 2>/dev/null)
if [ -z "$NZLD_ANY_VERSION" ] && [ -n "$VER" ] && [[ ${KNOWN[(i)$VER]} -gt ${#KNOWN} ]]; then
    die "CapCut $VER не поддержан (плагин собран под ${(j:, :)KNOWN})" \
"Обнови плагин или откати CapCut. Запустить на свой страх и риск:
     NZLD_ANY_VERSION=1 './CapCut Probe.command'"
fi

# ── подготовка ──────────────────────────────────────────────────────────────────
: > "$LOG"
# освободить порт от прошлого (осиротевшего) сервера — иначе app.py увидит занятый порт и выйдет,
# а старый процесс продолжит отдавать УСТАРЕВШИЙ код. Так гарантируем свежий сервер на каждый запуск.
lsof -ti tcp:8756 2>/dev/null | xargs kill 2>/dev/null
# сбросить прогресс: если прошлый сервер убили в середине операции (напр. add_object на «закрываю проект»),
# ve_progress.txt застревает на <100 и дилиб рисует залипшую плашку до следующей операции. 100 = скрыть.
echo "100 Готово" > "$UD/ve_progress.txt"

# ── бэкенд, и убедиться что он ЖИВ ──────────────────────────────────────────────
# KMP_DUPLICATE_LIB_OK здесь БОЛЬШЕ НЕ НУЖЕН и возвращать его нельзя: pycolmap теперь живёт
# в отдельном процессе (track3d_worker.py), а в этом остаётся только torch. Заглушка была
# официальным «небезопасным обходом» от самих OpenMP — она разрешает молча выдавать неверные
# числа, а у нас на кону солв камеры: ошибку в нём по картинке не увидеть.
BROWSER=none .venv/bin/python app.py > "$UD/ve_server.log" 2>&1 &
for i in {1..40}; do
    curl -s -m 1 -o /dev/null "http://127.0.0.1:8756/api/prefs" && break
    sleep 0.25
done
curl -s -m 1 -o /dev/null "http://127.0.0.1:8756/api/prefs" || die \
    "бэкенд не поднялся — панель осталась бы с пустым списком слоёв" \
    "Что случилось, написано в: $UD/ve_server.log"

# CapCut целиком на ВТОРОЙ экран и в фуллскрин: когда окно на одном мониторе, а меню
# всплывает на другом, координатные клики скриптов уезжают мимо. Просьба Назара, 2026-08-09.
# ❌ ОТКЛЮЧЕНО 2026-08-09. Программный перенос окна CapCut на другой экран гасит QML-раскладку:
# редактор открывается серым и пустым. Не помогло и «двигать только на главной, до открытия
# проекта» — проект, открытый в уже перенесённое окно, тоже сереет. Ставить окно на второй
# монитор надо ДО старта приложения (сохранённая рамка окна), а не двигать живое.
export DYLD_INSERT_LIBRARIES="$UD/ve_hook.dylib"
print -r -- "Бэкенд отвечает на 127.0.0.1:8756. CapCut запускается… лог: $LOG"
exec "$CAPCUT"
