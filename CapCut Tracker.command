#!/bin/bash
# Двойной клик запускает трекер. Открывается через Terminal — ему выдан Accessibility.
cd "$(dirname "$0")" || exit 1
echo "═══════════════════════════════════════════════"
echo "  CapCut Tracker запущен."
echo "  Открыть:  http://localhost:8756"
echo "  НЕ закрывай это окно, пока пользуешься тулом."
echo "═══════════════════════════════════════════════"
echo
.venv/bin/python app.py
echo
echo "Сервер остановлен. Можно закрыть окно."
